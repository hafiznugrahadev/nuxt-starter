# Development image — runs `nuxt dev` with hot reload.
# The project source is bind-mounted at runtime (see docker-compose.yml); the
# baked-in node_modules are kept via named volumes so they are not shadowed by
# the host mount.
FROM oven/bun:1.4

WORKDIR /app

# Install dependencies first for better layer caching.
# bun has no built-in download retry: one truncated tarball kills the build,
# so retry — the second attempt reuses bun's cache and only re-fetches the failure.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile \
  || (sleep 5 && bun install --frozen-lockfile) \
  || (sleep 10 && bun install --frozen-lockfile)

# Copy the rest (overlaid by the bind mount during `docker compose up`).
COPY . .

# Sync deps into the node_modules volume and apply migrations on every boot,
# so a dependency change only needs `docker compose up -d` (no volume rm).
# Run via `sh` — the bind mount carries the host file's permission bits, which
# may not include +x (fresh clones, some filesystems).
COPY docker-entrypoint.dev.sh ./
ENTRYPOINT ["sh", "./docker-entrypoint.dev.sh"]

EXPOSE 3000 24678

CMD ["bun", "run", "dev", "--host"]
