# Development image — runs `nuxt dev` with hot reload.
# The project source is bind-mounted at runtime (see docker-compose.yml); the
# baked-in node_modules and generated Prisma client are kept via named/anonymous
# volumes so they are not shadowed by the host mount.
FROM oven/bun:1.3

WORKDIR /app

# Install dependencies first for better layer caching.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Generate the Prisma client (needs the schema only).
COPY prisma ./prisma
RUN bunx prisma generate

# Copy the rest (overlaid by the bind mount during `docker compose up`).
COPY . .

EXPOSE 3000 24678

CMD ["bun", "run", "dev", "--host"]
