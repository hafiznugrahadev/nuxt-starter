# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuxt_starter?schema=public"

# Secret used by nuxt-auth-utils to seal the session cookie (min. 32 characters)
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD="please-change-this-to-a-random-32char-min-secret"

# Default admin credentials used by `bun run seed:admin`
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"
