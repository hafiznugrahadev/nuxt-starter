# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nuxt_starter?schema=public"

# Redis for Nitro cache. The cache uses LRU eviction and is separate from jobs.
REDIS_URL="redis://redis.nuxt-starter.orb.local:6379"

# Dedicated Redis for BullMQ. Do not point this at the cache instance.
QUEUE_REDIS_URL="redis://redis-queue.nuxt-starter.orb.local:6379"

# SMTP for password reset mail. The development Compose stack uses Mailpit.
SMTP_HOST="mailpit.nuxt-starter.orb.local"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Nuxt Starter <no-reply@localhost>"

# Secret used by Better Auth to sign session tokens (min. 32 characters).
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="please-change-this-to-a-random-32char-min-secret"

# Base URL of the app. Required when serving from a non-localhost origin
# (e.g. https://app.example.com); on localhost Better Auth derives it from the
# request automatically.
BETTER_AUTH_URL="http://localhost:3000"

# Allow visitors to self-register at /register. Also gates signUp on the server.
NUXT_PUBLIC_ENABLE_REGISTRATION="true"

# Basic-auth credentials for the API docs (/docs, /_openapi.json,
# /api/openapi.json, /api/auth/reference). Leave empty to keep docs public.
DOCS_BASIC_AUTH_USER=""
DOCS_BASIC_AUTH_PASSWORD=""

# Default admin credentials used by `bun run seed:admin`
ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"
